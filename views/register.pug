extends layout

block content
  div(class="min-h-[70vh] grid place-items-center")
    div(class="w-full max-w-md bg-white/90 backdrop-blur rounded-2xl p-7 shadow-soft border border-white/60")
      h2(class="text-2xl font-bold text-gray-900 mb-1") Créer un compte
      p(class="text-sm text-gray-600 mb-5") Accédez à la page des livres après inscription.

      if error
        div(class="mb-4 rounded-lg border border-red-200 bg-red-50 text-red-700 px-3 py-2") #{error}

      form(method="post", action="/register", class="space-y-4")
        div(class="space-y-1")
          label(class="text-sm font-medium") Nom
          input(type="text", name="name", value=name || '', required, placeholder="Votre nom"
            class="w-full p-2.5 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-500")

        div(class="space-y-1")
          label(class="text-sm font-medium") Email
          input(type="email", name="email", value=email || '', required, placeholder="vous@exemple.com"
            class="w-full p-2.5 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-500")

        div(class="space-y-1")
          label(class="text-sm font-medium") Mot de passe
          input(type="password", name="password", required, placeholder="••••••••"
            class="w-full p-2.5 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-500")

        div(class="space-y-1")
          label(class="text-sm font-medium") Confirmer le mot de passe
          input(type="password", name="confirm", required, placeholder="••••••••"
            class="w-full p-2.5 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-500")

        button(type="submit",
          class="w-full py-2.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-medium transition")
          | S'inscrire

      p(class="text-sm text-gray-600 mt-4 text-center")
        | Déjà inscrit ?
        a(href="/login", class="text-brand-700 hover:underline ml-1") Se connecter
