extends layout

block content
  // Header
  .mb-6.flex.items-center.justify-between
    .flex.items-center.gap-3
      - const initiale = (user && user.name) ? user.name.trim().charAt(0).toUpperCase() : 'U';
      .h-10.w-10.rounded-xl.bg-brand-600.text-white.flex.items-center.justify-center.font-semibold #{initiale}
      .leading-tight
        h1(class="text-2xl font-bold text-gray-900") Bonjour #{user.name}
        p(class="text-sm text-gray-600") Vos livres (stockés en mémoire)

    span(class="px-2 py-1 rounded-lg text-xs bg-brand-100 text-brand-700 border border-brand-200") Accès protégé

  // Grille de cartes
  ul(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5")
    each b in books
      - const pct = (b.pages && b.pagesRead != null) ? Math.round((b.pagesRead / b.pages) * 100) : null;
      li(class="bg-white/90 backdrop-blur rounded-2xl p-4 shadow-soft border border-white/60 hover:shadow-lg transition")
        h3(class="font-semibold text-gray-900") #{b.title}
        p(class="text-sm text-gray-600 mb-3") Auteur: #{b.author}

        // Ligne info (format + status)
        .flex.items-center.gap-3.text-sm.text-gray-700.mb-2
          if b.format
            span(class="px-2 py-0.5 rounded-md bg-gray-100 border") Format: #{b.format}
          if b.status
            span(class="px-2 py-0.5 rounded-md bg-gray-100 border") Status: #{b.status}

        // Barre de progression (si pages renseignées)
        if pct !== null && !isNaN(pct)
          .text-xs.text-gray-600.mb-1 #{b.pagesRead}/#{b.pages} pages — #{pct}%
          .w-full.h-2.rounded.bg-gray-200.overflow-hidden
            .h-2.rounded(style=`width:${Math.min(100, Math.max(0, pct))}%; background:#16a34a`)  // vert
